# Copy to .env, fill in your own values, and export them before running the optional
# model calls. The analysis scripts in scripts/01-04 do not need any of these.

# Zotero web library (scripts/run_pipeline.py)
ZOTERO_API_KEY=
ZOTERO_USER_ID=
# Local Zotero storage folder with the PDF attachments (full-text stages)
ZOTERO_STORAGE_DIR=

# Alibaba Cloud Model Studio (Qwen Max; scripts/run_pipeline.py)
QWEN_API_KEY=

# OpenRouter (model_comparison/revision_experiment.py run --execute)
OPENROUTER_API_KEY=
